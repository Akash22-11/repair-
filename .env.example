# Copy to .env (never commit it) and start with:  uvicorn app.main:app --env-file .env
MODEL=Qwen/Qwen3-VL-8B-Instruct
# Optional local directory with the weights (skips the download)
MODEL_PATH=
# auto | cuda | cpu
DEVICE=auto
# 4bit | 8bit | none  (bitsandbytes, CUDA only; ignored on CPU)
QUANTIZATION=4bit
# auto | bfloat16 | float16 | float32
DTYPE=auto
# Weight budget on GPU 0 in GiB; layers that do not fit are offloaded to CPU RAM
GPU_MAX_MEMORY_GB=5.0
CPU_MAX_MEMORY_GB=24
# Load the model in a background thread at startup
PRELOAD_MODEL=true

MAX_NEW_TOKENS=500
REVIEW_MAX_NEW_TOKENS=400
# Per model call: pass 1 and pass 2 each get this budget
MODEL_TIMEOUT_SECONDS=90
SECOND_PASS=true

MAX_IMAGE_BYTES=12582912
MAX_IMAGE_PIXELS=12000000
# Longest image side sent to the model (controls image tokens / VRAM)
IMAGE_MAX_SIDE=896
# norm1000 (Qwen3-VL) | pixel | normalized
BBOX_MODE=norm1000
PROMPT_VERSION=v1
# Requests allowed to wait behind the running one (more -> HTTP 503 inference_busy)
MAX_QUEUE=2

# Comma-separated list
CORS_ORIGINS=http://localhost:3000
# Empty = auth disabled; otherwise clients must send header X-API-Key
REPAIR_API_KEY=

# Optional Hugging Face cache location
# HF_HOME=D:/hf_cache
